{
  "expo": {
    "name": "BlasterZone",
    "slug": "67",
    "owner": "blaster-1s-team",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nrxd.blasterzone",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BlasterZone needs mic for Discord voice.",
        "NSCameraUsageDescription": "BlasterZone needs camera for Discord video.",
        "NSPhotoLibraryUsageDescription": "BlasterZone needs photos for profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.nrxd.blasterzone",
      "permissions": ["RECORD_AUDIO", "CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-av"
    ],
    "extra": {
      "eas": {
        "projectId": "be5e2cba-ada3-4e62-b3f0-bbcd578ef798"
      }
    }
  }
}
